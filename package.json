{
  "name": "diffler",
  "version": "4.0.1",
  "description": "A recursive JSON comparison script for humans",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json --emitDeclarationOnly && cp dist/index.d.ts dist/index.d.cts",
    "test": "vitest run",
    "test:terse": "vitest run --reporter=./src/terse-reporter.ts",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "check-types": "tsc --noEmit",
    "bench": "vitest bench --run",
    "release": "./scripts/release.sh",
    "prepare": "lefthook install"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omgaz/diffler.git"
  },
  "keywords": [
    "recursive",
    "difference",
    "comparison",
    "compare",
    "diff",
    "js-diff",
    "deep-diff"
  ],
  "author": "Gary Chisholm",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/omgaz/diffler/issues"
  },
  "homepage": "https://github.com/omgaz/diffler",
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "lefthook": "^2.1.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
